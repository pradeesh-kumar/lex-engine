<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lexengine</groupId>
        <artifactId>lexengine-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>lexengine-cli</artifactId>
    <name>Lex-Engine CLI</name>
    <description>Executable CLI and portable distribution containing the generators and compiled examples.</description>
    <properties>
        <lexengine.distributionDirectory>${project.basedir}/../bin</lexengine.distributionDirectory>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.lexengine</groupId>
            <artifactId>lexengine-examples</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <build>
        <finalName>lex-engine</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>package-cli</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes><exclude>META-INF/MANIFEST.MF</exclude></excludes>
                                </filter>
                                <filter>
                                    <artifact>org.lexengine:lexengine-parser</artifact>
                                    <excludes>
                                        <exclude>lexer-spec.spec</exclude>
                                        <exclude>scanner-class.template</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.lexengine.cli.Main</mainClass>
                                    <manifestEntries>
                                        <Implementation-Title>Lex-Engine CLI</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>build-bin-distribution</id>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${lexengine.distributionDirectory}"/>
                                <copy file="${project.build.directory}/lex-engine.jar" tofile="${lexengine.distributionDirectory}/lex-engine.jar" overwrite="true"/>
                                <copy file="${project.basedir}/src/main/scripts/lexengine" tofile="${lexengine.distributionDirectory}/lexengine" overwrite="true"/>
                                <copy file="${project.basedir}/src/main/scripts/lexengine.cmd" tofile="${lexengine.distributionDirectory}/lexengine.cmd" overwrite="true"/>
                                <chmod file="${lexengine.distributionDirectory}/lexengine" perm="755" osfamily="unix"/>
                                <echo level="info" message="CLI ready: ${lexengine.distributionDirectory}/lexengine"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>${lexengine.distributionDirectory}</directory>
                            <includes>
                                <include>lexengine</include>
                                <include>lexengine.cmd</include>
                                <include>lex-engine.jar</include>
                            </includes>
                            <followSymlinks>false</followSymlinks>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <lexengine.distributionDirectory>${lexengine.distributionDirectory}</lexengine.distributionDirectory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
